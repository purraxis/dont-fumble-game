# Client-safe Supabase values. These may be exposed to the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-side Supabase values. Do not prefix the service role key with VITE_.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-side Lovable AI gateway key.
LOVABLE_API_KEY=
